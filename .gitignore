# Python
__pycache__/
*.pyc
venv/

# PyInstaller 빌드 산출물
build/
dist/
build_headless/
dist_headless/
build_headless2/
dist_headless2/
*.spec

# native/ 빌드 산출물 (native/build_worker.bat이 생성 - 소스(.c)만 커밋한다)
native/*.exe
native/*.obj
native/*.o
native/*.pdb
native/*.ilk

# 사용자 실행 데이터 (실행 시 자동 생성됨, 저장소에 포함하지 않음)
config.json
backup/
logs/

# OS
.DS_Store
Thumbs.db

# UI 테스트 (Playwright)
node_modules/
test-results/
playwright-report/

# 앱 런타임 데이터 (registry/archive/cache DB, 클립보드 핸드오프 파일)
db/
clipboard/

# Codex가 대화 첨부를 작업 공간에 풀어 둔 파일. 자격정보 이미지 등이 포함될 수 있다.
.codex-remote-attachments/
